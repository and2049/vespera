# Checks placement and formerCategories against the value lists the Swift discovery tests share.
# Each case copies PACKAGE to WORK, rewrites its manifest and runs only the manifest check.
file(READ "${PACKAGE}/module.json" original)
string(JSON id GET "${original}" id)
file(READ "${VALUES}" values)

set(index 0)
function(check_manifest category member expected_exit)
  math(EXPR next "${index} + 1")
  set(index ${next} PARENT_SCOPE)
  set(package "${WORK}/case-${index}.vespera")
  file(REMOVE_RECURSE "${package}")
  file(COPY "${PACKAGE}/" DESTINATION "${package}")
  file(WRITE "${package}/module.json"
    "{\"schemaVersion\": 1, \"id\": \"${id}\", \"category\": \"${category}\", "
    "\"binary\": \"module.so\", \"icon\": \"icon.svg\", \"resources\": \"resources\", ${member}}\n")
  execute_process(COMMAND "${TOOL}" --checks manifest "${package}"
    RESULT_VARIABLE exit OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT exit STREQUAL expected_exit)
    message(FATAL_ERROR
      "${category} with ${member}: expected exit ${expected_exit}, got ${exit}\n${output}${error}")
  endif()
endfunction()

foreach(key placement formerCategories)
  foreach(kind valid invalid)
    string(JSON count LENGTH "${values}" ${key} ${kind})
    math(EXPR last "${count} - 1")
    foreach(item RANGE ${last})
      string(JSON value GET "${values}" ${key} ${kind} ${item})
      string(JSON type TYPE "${values}" ${key} ${kind} ${item})
      if(type STREQUAL "STRING")
        set(value "\"${value}\"")
      elseif(type STREQUAL "NULL")
        set(value "null")
      elseif(type STREQUAL "BOOLEAN")
        if(value)
          set(value "true")
        else()
          set(value "false")
        endif()
      endif()
      if(kind STREQUAL "valid")
        check_manifest(special-fx "\"${key}\": ${value}" 0)
      else()
        check_manifest(special-fx "\"${key}\": ${value}" 1)
      endif()
    endforeach()
  endforeach()
endforeach()

# Routing cases: each sets schemaVersion, an optional category and manifest members.
string(JSON cases LENGTH "${values}" routingCases)
math(EXPR last "${cases} - 1")
foreach(item RANGE ${last})
  string(JSON entry GET "${values}" routingCases ${item})
  string(JSON schema GET "${entry}" schemaVersion)
  string(JSON category ERROR_VARIABLE missing GET "${entry}" category)
  if(missing)
    set(category special-fx)
  endif()
  string(JSON valid GET "${entry}" valid)
  set(manifest "{\"schemaVersion\": ${schema}, \"id\": \"${id}\", \"category\": \"${category}\", \"binary\": \"module.so\", \"icon\": \"icon.svg\", \"resources\": \"resources\"}")
  string(JSON members LENGTH "${entry}" fields)
  if(members GREATER 0)
    math(EXPR last_member "${members} - 1")
    foreach(member RANGE ${last_member})
      string(JSON key MEMBER "${entry}" fields ${member})
      string(JSON type TYPE "${entry}" fields ${key})
      string(JSON value GET "${entry}" fields ${key})
      if(type STREQUAL "STRING")
        set(value "\"${value}\"")
      elseif(type STREQUAL "NULL")
        set(value "null")
      endif()
      string(JSON manifest SET "${manifest}" ${key} "${value}")
    endforeach()
  endif()
  math(EXPR index "${index} + 1")
  set(package "${WORK}/case-${index}.vespera")
  file(REMOVE_RECURSE "${package}")
  file(COPY "${PACKAGE}/" DESTINATION "${package}")
  file(WRITE "${package}/module.json" "${manifest}\n")
  execute_process(COMMAND "${TOOL}" --checks manifest "${package}"
    RESULT_VARIABLE exit OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(valid)
    set(expected 0)
  else()
    set(expected 1)
  endif()
  if(NOT exit STREQUAL expected)
    message(FATAL_ERROR "routing case ${item} (${manifest}): expected exit ${expected}, got "
      "${exit}\n${output}${error}")
  endif()
endforeach()

# A placement belongs to Special FX alone; null is the same as absent everywhere.
check_manifest(pre-fx "\"placement\": \"after-cabinet\"" 1)
check_manifest(amp "\"placement\": \"before-amp\"" 1)
check_manifest(pre-fx "\"placement\": null" 0)
check_manifest(pre-fx "\"formerCategories\": [\"special-fx\"]" 0)
check_manifest(pre-fx "\"formerCategories\": [\"pre-fx\"]" 1)
