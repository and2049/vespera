# Runs vespera-module-check on PACKAGE and requires that exactly the FAIL results fail, that every
# PASS result passes and that every WARN result warns. Results are named target:check; the lists
# separate them by commas.
string(REPLACE "," ";" FAIL "${FAIL}")
string(REPLACE "," ";" PASS "${PASS}")
string(REPLACE "," ";" WARN "${WARN}")
if(NOT DEFINED CPU_LIMIT)
  set(CPU_LIMIT 50)
endif()
execute_process(COMMAND "${TOOL}" --json --cpu-seconds 0.2 --cpu-limit "${CPU_LIMIT}" "${PACKAGE}"
  RESULT_VARIABLE exit OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(FAIL)
  set(expected_exit 1)
else()
  set(expected_exit 0)
endif()
if(NOT exit STREQUAL expected_exit)
  message(FATAL_ERROR "expected exit ${expected_exit}, got ${exit}\n${output}${error}")
endif()

string(JSON count ERROR_VARIABLE parse LENGTH "${output}" results)
if(parse)
  message(FATAL_ERROR "output is not the expected JSON: ${parse}\n${output}${error}")
endif()
set(failed "")
set(passed "")
set(warned "")
math(EXPR last "${count} - 1")
foreach(index RANGE ${last})
  string(JSON target GET "${output}" results ${index} target)
  string(JSON check GET "${output}" results ${index} check)
  string(JSON status GET "${output}" results ${index} status)
  if(status STREQUAL "fail")
    list(APPEND failed "${target}:${check}")
  elseif(status STREQUAL "pass")
    list(APPEND passed "${target}:${check}")
  elseif(status STREQUAL "warn")
    list(APPEND warned "${target}:${check}")
  endif()
endforeach()

set(problems "")
foreach(result IN LISTS failed)
  if(NOT result IN_LIST FAIL)
    string(APPEND problems "${result} failed unexpectedly\n")
  endif()
endforeach()
foreach(result IN LISTS FAIL)
  if(NOT result IN_LIST failed)
    string(APPEND problems "${result} did not fail\n")
  endif()
endforeach()
foreach(result IN LISTS PASS)
  if(NOT result IN_LIST passed)
    string(APPEND problems "${result} did not pass\n")
  endif()
endforeach()
foreach(result IN LISTS WARN)
  if(NOT result IN_LIST warned)
    string(APPEND problems "${result} did not warn\n")
  endif()
endforeach()
if(problems)
  message(FATAL_ERROR "${problems}${output}${error}")
endif()
