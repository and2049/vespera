function(check_cli name expected_exit expected_output)
  execute_process(COMMAND "${TOOL}" ${ARGN}
    RESULT_VARIABLE exit OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT exit STREQUAL expected_exit)
    message(FATAL_ERROR "${name}: expected exit ${expected_exit}, got ${exit}\n${output}${error}")
  endif()
  if(NOT "${output}${error}" MATCHES "${expected_output}")
    message(FATAL_ERROR "${name}: expected output matching ${expected_output}\n${output}${error}")
  endif()
endfunction()

check_cli(help 0 "usage: vespera-module-check" --help)
check_cli(missing_package 2 "missing package")
check_cli(two_packages 2 "expected one package" "${PACKAGE}" "${PACKAGE}")
check_cli(unknown_option 2 "unknown option --fast" --fast "${PACKAGE}")
check_cli(unknown_check 2 "unknown check \"speed\"" --checks abi,speed "${PACKAGE}")
check_cli(invalid_rate 2 "--rates expects" --rates 48000,4000 "${PACKAGE}")
check_cli(invalid_tolerance 2 "--tolerance expects" --tolerance nan "${PACKAGE}")
check_cli(missing_value 2 "--cpu-limit requires a value" "${PACKAGE}" --cpu-limit)
check_cli(no_manifest 1 "FAIL +package +manifest +cannot read" "${WORK}/absent.vespera")
check_cli(selected 0 "PASS +module +abi .*1 passed, 0 warnings, 0 failed" --checks abi "${PACKAGE}")
check_cli(json 0 "\"passed\": true" --json --checks manifest,abi "${PACKAGE}")
check_cli(cpu_limit 1 "FAIL +module +cpu .*above the limit of 0%"
  --checks cpu --cpu-limit 0 --cpu-seconds 0.05 "${PACKAGE}")
